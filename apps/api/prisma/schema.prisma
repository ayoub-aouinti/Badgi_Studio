generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Event (single standalone event; no dependency on any external platform) ---

model Event {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  startsAt  DateTime? @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  createdAt DateTime  @default(now()) @map("created_at")

  studioConfig       StudioConfig?
  kiosks             Kiosk[]
  studioParticipants StudioParticipant[]

  @@map("events")
}

// --- Badgi Studio tables ---

model StudioConfig {
  id             String  @id @default(uuid())
  eventId        String  @unique @map("event_id")
  enabled        Boolean @default(false)
  // Branding, edited from the admin space and applied to the kiosk, wall and portrait frame.
  logoKey        String? @map("logo_key")
  tagline        String?
  primaryColor   String  @default("#0B6E69") @map("primary_color")
  accentColor    String  @default("#5FD3C8") @map("accent_color")
  // none | banner | border | polaroid
  frameStyle     String  @default("banner") @map("frame_style")
  frameColor     String  @default("#0E1B2C") @map("frame_color")
  frameWidth     Int     @default(32) @map("frame_width")
  showName       Boolean @default(true) @map("show_name")
  showLogo       Boolean @default(true) @map("show_logo")
  retentionDays  Int     @default(30) @map("retention_days")
  // Every portrait waits for the organiser's approval before reaching the wall.
  preModeration  Boolean @default(false) @map("pre_moderation")
  // Kiosk "Imprimer" button (a printer is connected to the tablet for this event).
  printEnabled   Boolean @default(false) @map("print_enabled")
  // Public online gallery /g/:galleryToken of the portraits shown on the wall.
  galleryEnabled Boolean @default(false) @map("gallery_enabled")
  galleryToken   String  @unique @default(uuid()) @map("gallery_token")
  wallToken      String  @unique @map("wall_token")

  event  Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  styles StudioStyle[]

  @@map("studio_configs")
}

model StudioStyle {
  id         String  @id @default(uuid())
  configId   String  @map("config_id")
  name       String
  // Rendering recipe for the local providers (mock/animegan); paid providers use `prompt`.
  // pro | caricature | pencil | painted | comic (see StylePreset in @badgi-studio/shared).
  preset     String  @default("pro")
  prompt     String
  model      String
  previewKey String? @map("preview_key")
  sortOrder  Int     @default(0) @map("sort_order")
  active     Boolean @default(true)

  config    StudioConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  portraits Portrait[]

  @@index([configId])
  @@map("studio_styles")
}

enum KioskStatus {
  ONLINE
  OFFLINE
}

model Kiosk {
  id              String      @id @default(uuid())
  eventId         String      @map("event_id")
  name            String
  pairingCode     String      @unique @map("pairing_code")
  deviceTokenHash String?     @map("device_token_hash")
  lastSeenAt      DateTime?   @map("last_seen_at")
  status          KioskStatus @default(OFFLINE)

  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  captureSessions CaptureSession[]

  @@index([eventId])
  @@map("kiosks")
}

model StudioParticipant {
  id           String   @id @default(uuid())
  eventId      String   @map("event_id")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  email        String?
  whatsappE164 String?  @map("whatsapp_e164")
  createdAt    DateTime @default(now()) @map("created_at")

  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  consents        Consent[]
  captureSessions CaptureSession[]

  @@index([eventId])
  @@map("studio_participants")
}

enum ConsentType {
  AI_PROCESSING
  WALL
}

model Consent {
  id            String      @id @default(uuid())
  participantId String      @map("participant_id")
  type          ConsentType
  granted       Boolean
  grantedAt     DateTime    @map("granted_at")
  textVersion   String      @map("text_version")

  participant StudioParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
  @@map("consents")
}

enum CaptureSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model CaptureSession {
  id            String               @id @default(uuid())
  kioskId       String               @map("kiosk_id")
  participantId String               @map("participant_id")
  startedAt     DateTime             @default(now()) @map("started_at")
  endedAt       DateTime?            @map("ended_at")
  status        CaptureSessionStatus @default(IN_PROGRESS)

  kiosk       Kiosk             @relation(fields: [kioskId], references: [id], onDelete: Cascade)
  participant StudioParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  portraits   Portrait[]

  @@index([kioskId])
  @@index([participantId])
  @@map("capture_sessions")
}

enum PortraitStatus {
  QUEUED
  MODERATING
  GENERATING
  READY
  REJECTED
  FAILED
}

// Wall moderation, separate from `status`: a rejected portrait (manual) is still delivered to
// the participant; an automatically rejected selfie is never generated (status REJECTED).
enum ModerationStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

model Portrait {
  id                String           @id @default(uuid())
  sessionId         String           @map("session_id")
  styleId           String           @map("style_id")
  // Image keys are cleared by the purge job (docs/SPEC.md: files deleted at J+retention).
  selfieKey         String?          @map("selfie_key")
  resultKey         String?          @map("result_key")
  framedKey         String?          @map("framed_key")
  sketchKey         String?          @map("sketch_key")
  // MP4 of the live drawing (ink, colour, frame), rendered after the portrait is ready.
  videoKey          String?          @map("video_key")
  status            PortraitStatus   @default(QUEUED)
  providerRequestId String?          @map("provider_request_id")
  costUsd           Decimal?         @map("cost_usd") @db.Decimal(10, 4)
  onWall            Boolean          @default(false) @map("on_wall")
  pinned            Boolean          @default(false)
  moderation        ModerationStatus @default(NOT_REQUIRED)
  moderationReason  String?          @map("moderation_reason")
  moderatedAt       DateTime?        @map("moderated_at")
  publicCode        String           @unique @map("public_code")
  createdAt         DateTime         @default(now()) @map("created_at")
  purgeAt           DateTime         @map("purge_at")
  purgedAt          DateTime?        @map("purged_at")

  session    CaptureSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  style      StudioStyle    @relation(fields: [styleId], references: [id])
  deliveries Delivery[]

  @@index([status])
  @@index([moderation])
  @@index([purgeAt])
  @@index([sessionId])
  @@map("portraits")
}

enum DeliveryChannel {
  EMAIL
  WHATSAPP
  PRINT
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

model Delivery {
  id                String          @id @default(uuid())
  portraitId        String          @map("portrait_id")
  channel           DeliveryChannel
  recipient         String
  status            DeliveryStatus  @default(PENDING)
  providerMessageId String?         @map("provider_message_id")
  costUsd           Decimal?        @map("cost_usd") @db.Decimal(10, 4)
  sentAt            DateTime?       @map("sent_at")
  error             String?

  portrait Portrait @relation(fields: [portraitId], references: [id], onDelete: Cascade)

  @@index([portraitId])
  @@map("deliveries")
}
