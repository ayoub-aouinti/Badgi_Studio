# The Prisma CLI only reads a .env next to (or above) the schema it runs from,
# so this mirrors DATABASE_URL from the root .env.example for `prisma migrate`/`db seed`.
# The NestJS app itself loads the root .env via ConfigModule (see app.module.ts).
DATABASE_URL=postgresql://badgi:badgi@localhost:5436/badgi_studio?schema=public
