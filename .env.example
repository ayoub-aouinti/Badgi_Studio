# Copy to .env at the repo root: cp .env.example .env
# Used by docker-compose.yml and by apps/api (ConfigModule loads this root .env).

# --- API ---
NODE_ENV=development
PORT=3100
PUBLIC_BASE_URL=http://localhost:3100
# Secret used to hash/sign kiosk device tokens and the admin session token.
DEVICE_TOKEN_SECRET=change-me-in-production
# Password of the organiser admin space (apps/dashboard). Change it!
ADMIN_PASSWORD=admin

# --- PostgreSQL (docker-compose: postgres) ---
POSTGRES_USER=badgi
POSTGRES_PASSWORD=badgi
POSTGRES_DB=badgi_studio
# 5436 (not the default 5432) to avoid clashing with a locally installed PostgreSQL service
# or other projects' Docker Postgres containers already using 5432-5435 on this machine.
POSTGRES_PORT=5436
DATABASE_URL=postgresql://badgi:badgi@localhost:5436/badgi_studio?schema=public

# --- Redis (docker-compose: redis, used by BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- MinIO (docker-compose: minio, S3-compatible storage) ---
MINIO_ROOT_USER=badgi
MINIO_ROOT_PASSWORD=badgi123456
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=badgi-studio
MINIO_ENDPOINT=localhost
MINIO_USE_SSL=false

# --- Mailpit (docker-compose: mailpit, SMTP capture for dev) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=studio@example.com
# Real SMTP relay only (leave empty for Mailpit): credentials and TLS (true for port 465).
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# --- External service adapters (interface + adapter pattern, see CLAUDE.md) ---
# Each style has a preset (pro | caricature | pencil | painted | comic) used by the local providers;
# the paid providers send the style prompt instead.
# mock (default, free/local: photo treatments per preset; caricature = face warp, bigger head/eyes)
# animegan (free/local: painted output for the "caricature" and "painted" presets, ~4 s on CPU;
#   model from bryandlee/animegan2-pytorch, MIT repo — confirm the weights' licence before
#   commercial use; downloaded by `pnpm --filter @badgi-studio/api models:download`)
# fal | gemini (paid: generative image editing, needs the API key below)
AI_PROVIDER=mock
ANIMEGAN_MODEL_PATH=
# UltraFace RFB-320 face detector (MIT) for the caricature warp; same download script.
FACE_DETECTION_MODEL_PATH=
# AI_PROVIDER=fal — https://fal.ai (FLUX.1 Kontext [pro] by default, ~0.04 $/image)
FAL_KEY=
FAL_MODEL=fal-ai/flux-pro/kontext
FAL_COST_USD=0.04
# AI_PROVIDER=gemini — Google AI Studio API key (Gemini image model, ~0.039 $/image)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-image
GEMINI_COST_USD=0.039
# local (default, ./storage) | s3 (MinIO in docker, or real S3 later)
STORAGE_DRIVER=local
# smtp (Mailpit in dev, real SMTP provider later e.g. Brevo/Gmail)
MAIL_DRIVER=smtp
# link (default, free wa.me QR) | cloud_api (Meta WhatsApp Cloud API, later)
WHATSAPP_MODE=link

# --- Background removal (free/local: onnxruntime-node + U²-Net u2netp, Apache-2.0) ---
# Download the model once: pnpm --filter @badgi-studio/api models:download
# If the model file is missing, background removal is skipped (original selfie is used).
BG_REMOVAL_MODEL_PATH=
BG_REMOVAL_BACKGROUND="#F4F6F5"

# --- Default retention (days) before purge job deletes portraits/PII ---
DEFAULT_RETENTION_DAYS=30
# How often the purge job runs (BullMQ repeatable job on the maintenance queue).
PURGE_INTERVAL_MINUTES=60
